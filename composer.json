{
  "name": "bentonow/bento-laravel-sdk",
  "description": "Laravel SDK for Bento",
  "keywords": [
    "Bento",
    "Bentonow",
    "bento",
    "bentonow",
    "email",
    "transactional",
    "laravel-driver"
  ],
  "homepage": "https://github.com/bentonow/bento-laravel-sdk",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Aaron Francis",
      "email": "hello@aaronfrancis.com",
      "homepage": "https://aaronfrancis.com",
      "role": "Developer"
    },
    {
      "name": "Zachary Oakes",
      "email": "zachary.oakes@gmail.com",
      "homepage": "https://www.zacharyoakes.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "saloonphp/saloon": "^3.11.2 || ^4.0"
  },
  "require-dev": {
    "laravel/pint": "^v1.21.2",
    "laravel/prompts": "^0.3.5",
    "orchestra/testbench": "^v9.12.0 || ^v10.11.0 || ^v11.2.0",
    "pestphp/pest": "^v3.7.4 || ^v4.1.0 || ^v5.1.3",
    "pestphp/pest-plugin-arch": "^3.1 || ^4.0 || ^5.0",
    "pestphp/pest-plugin-laravel": "^v3.1.0 || ^v4.1.0 || ^v5.0.1",
    "spatie/ray": "^1.41.6"
  },
  "autoload": {
    "psr-4": {
      "Bentonow\\BentoLaravel\\": "src/",
      "Bentonow\\BentoLaravel\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/pest"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false,
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bentonow\\BentoLaravel\\BentoLaravelServiceProvider"
      ],
      "aliases": {
        "Bento": "Bentonow\\BentoLaravel\\Facades\\Bento"
      }
    }
  }
}
